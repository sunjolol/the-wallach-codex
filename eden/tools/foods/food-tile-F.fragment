<!-- F · LABEL — the other coherent reading of the same card.
     A title BAR spanning the full width, then the body beneath it. Long names get the whole
     340px instead of competing with a verdict column, so "Sardines, canned with bones" stops
     wrapping into two lines and the card keeps one rhythm.

     The control sits in the title bar, aligned to the name's optical centre rather than floated
     into the card's vertical middle -- so it reads as "this row's action" and cannot drift when
     the body grows a chip row.

     Same rules as E: one 28px control shell for both states, at most 7 essentials then "+N",
     with the measured row fit underneath. -->
<style>
.lb{ --min:#2b6fb0; --vit:#ff7e3c; --ome:#7d4a86;
     display:grid; grid-template-columns:340px; gap:8px; justify-content:center; }
.lb-note{ font:400 9px/1.4 var(--ds-font-mono,monospace); color:var(--ds-ink-faint);
  border-bottom:1px dashed var(--ds-rule-soft); padding-bottom:6px; }

.lb-tile{ width:340px; box-sizing:border-box; overflow:hidden;
  background:var(--ds-paper-light); border-radius:var(--ds-radius-sm);
  box-shadow: inset 0 0 0 1px var(--ds-rule-soft), 0 1px 4px -2px rgba(26,22,18,.20); }

/* ── title bar ── */
.lb-bar{ display:grid; grid-template-columns:1fr 30px; column-gap:8px; align-items:center;
  padding:6px 8px 6px 10px;
  background:color-mix(in srgb, var(--acc) 7%, transparent);
  border-bottom:1px solid color-mix(in srgb, var(--acc) 22%, transparent);
  border-left:3px solid var(--acc); }
.lb-bar__txt{ min-width:0; }
.lb-name{ font:600 13px/1.2 var(--ds-font-display,sans-serif); color:var(--ds-ink);
  white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
.lb-meta{ font:400 9px/1.25 var(--ds-font-mono,monospace); color:var(--ds-ink-soft);
  white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
.lb-meta b{ color:var(--ds-ink-medium); font-weight:700; }

/* ── body ── */
.lb-body{ display:grid; grid-template-columns:auto 1fr; column-gap:10px; align-items:start;
  padding:7px 10px 8px; }
.lb-lead{ text-align:left; padding-right:9px; border-right:1px solid var(--ds-rule-soft); }
.lb-lead__pct{ font:700 21px/.88 var(--ds-font-display,sans-serif); color:var(--acc); letter-spacing:-.035em; }
.lb-lead__pct sup{ font-size:10px; top:-.65em; }
.lb-lead__of{ margin-top:2px; font:700 8px/1.2 var(--ds-font-mono,monospace); letter-spacing:.05em;
  text-transform:uppercase; color:var(--ds-ink); white-space:nowrap; }
.lb-chips{ display:flex; flex-wrap:wrap; gap:3px; padding-top:1px; }
.lb-chip{ display:inline-flex; align-items:baseline; gap:3px; white-space:nowrap;
  padding:1px 6px 2px; border-radius:var(--ds-radius-pill);
  font:700 8px/1.4 var(--ds-font-mono,monospace); letter-spacing:.03em;
  color:color-mix(in srgb,var(--c) 76%,#000); background:color-mix(in srgb,var(--c) 14%,transparent); }
.lb-chip u{ text-decoration:none; font-weight:400; opacity:.75; }
.lb-chip--approx::after{ content:'≈'; opacity:.55; font-weight:400; }
.lb-more{ align-self:center; padding:1px 3px; white-space:nowrap;
  font:700 8px/1.4 var(--ds-font-mono,monospace); color:var(--ds-ink-soft); }

.lb-a{ display:grid; place-items:center; }
.lb-ctl--add:hover{ background:var(--ds-ink); border-color:var(--ds-ink); color:var(--ds-paper); }
</style>

<div class="lb-note" id="lb-note">F · label — title bar spans the card, body carries the verdict</div>
<div class="lb" id="lb-root"></div>

<script>
(() => {
  const CAP = 7;        // at most this many essentials before "+N"
  const MAX_ROWS = 3;  // and never more chip rows than this, whatever the names are

  // ── ONE control shell for both states ───────────────────────────────────────
  // Both take .ui-close--sm's 28px circle, border, shadow and flex centring; they differ only
  // by the SVG path. That is why they now match in size and sit dead centre -- the previous
  // pass mixed an 18px .rec__add text glyph with a 28px .ui-close--sm SVG.
  const X_PATH = 'M6 6l12 12M18 6L6 18';
  const ADD_PATH = 'M12 6v12M6 12h12';
  const ctl = (inRegimen, name) =>
    `<button class="ui-close ui-close--sm lb-ctl${inRegimen ? '' : ' lb-ctl--add'}" type="button"
       aria-label="${inRegimen ? 'Remove' : 'Add'} ${name}">
       <svg viewBox="0 0 24 24" aria-hidden="true"><path d="${inRegimen ? X_PATH : ADD_PATH}"/></svg>
     </button>`;

  const rowCount = (el) => {
    const tops = new Set();
    for (const c of el.children) tops.add(Math.round(c.offsetTop));
    return tops.size;
  };

  /** Show at most CAP chips, and shrink further if the rendered rows exceed MAX_ROWS. */
  function fitChips(host, chips) {
    const total = chips.length;
    const paint = (n) => {
      const parts = chips.slice(0, n).map(([k, p, c, ap]) =>
        `<span class="lb-chip${ap ? ' lb-chip--approx' : ''}" style="--c:var(--${c})">${k.toUpperCase()} <u>${p}%</u></span>`);
      if (n < total) parts.push(`<span class="lb-more">+${total - n}</span>`);
      host.innerHTML = parts.join('');
    };
    let n = Math.min(CAP, total);
    paint(n);
    while (n > 0 && rowCount(host) > MAX_ROWS) { n -= 1; paint(n); }
    return n;
  }

  const DATA = [{"name":"Spinach, cooked","sub":"1 cup · 180 g","n":12,"acc":"vit","hits":[["Vitamin K",296,"vit",0],["Choline",35,"vit",0],["Folate",26,"vit",0],["Silica",24,"min",1],["Manganese",22,"min",0],["Magnesium",20,"min",0],["Potassium",17,"min",0],["Sodium",17,"min",0],["Calcium",16,"min",0],["Iron",14,"min",0],["Copper",10,"min",0],["Vitamin A",10,"vit",0]]},{"name":"Lamb liver","sub":"3 oz · 85 g","n":10,"acc":"min","hits":[["Copper",270,"min",0],["Vitamin A",74,"vit",0],["Folate",34,"vit",0],["Selenium",32,"min",0],["Iron",19,"min",0],["Vitamin B12",18,"vit",0],["Vitamin B3",14,"vit",0],["Omega EFAs",14,"ome",0],["Zinc",10,"min",0],["Vitamin B2",8,"vit",0]]},{"name":"Natto","sub":"1 cup · 175 g","n":10,"acc":"ome","hits":[["Omega EFAs",178,"ome",0],["Choline",100,"vit",0],["Copper",38,"min",0],["Manganese",35,"min",0],["Iron",33,"min",0],["Magnesium",26,"min",0],["Potassium",26,"min",0],["Calcium",25,"min",0],["Vitamin K",13,"vit",0],["Zinc",12,"min",0]]},{"name":"Soybeans, cooked","sub":"1 cup · 172 g","n":10,"acc":"ome","hits":[["Omega EFAs",143,"ome",0],["Choline",82,"vit",0],["Copper",23,"min",0],["Iron",19,"min",0],["Magnesium",19,"min",0],["Manganese",18,"min",0],["Potassium",18,"min",0],["Calcium",12,"min",0],["Vitamin K",11,"vit",0],["Folate",9,"vit",0]]},{"name":"Beef liver","sub":"3 oz · 85 g","n":9,"acc":"min","hits":[["Copper",392,"min",0],["Choline",362,"vit",0],["Vitamin A",89,"vit",0],["Folate",22,"vit",0],["Vitamin B12",15,"vit",0],["Vitamin B3",15,"vit",0],["Iron",12,"min",0],["Selenium",10,"min",0],["Zinc",10,"min",0]]},{"name":"Chicken liver","sub":"3 oz · 85 g","n":9,"acc":"vit","hits":[["Choline",278,"vit",0],["Folate",48,"vit",0],["Vitamin A",41,"vit",0],["Iron",24,"min",0],["Selenium",24,"min",0],["Copper",15,"min",0],["Vitamin B3",12,"vit",0],["Vitamin B5",7,"vit",0],["Zinc",7,"min",0]]},{"name":"Chickpeas, cooked","sub":"1 cup · 164 g","n":9,"acc":"vit","hits":[["Choline",70,"vit",0],["Omega EFAs",31,"ome",0],["Folate",28,"vit"
cc":"min","hits":[["Manganese",9,"min",0]]},{"name":"Mozzarella","sub":"1 oz · 28.35 g","n":1,"acc":"min","hits":[["Calcium",10,"min",0]]},{"name":"Orange","sub":"1 fruit (2-5/8\" dia) · 131 g","n":1,"acc":"vit","hits":[["Choline",11,"vit",0]]},{"name":"Parsley, fresh","sub":"1 tbsp · 3.8 g","n":1,"acc":"vit","hits":[["Vitamin K",21,"vit",0]]},{"name":"Parsnips, cooked","sub":"0.5 cup slices · 78 g","n":1,"acc":"vit","hits":[["Choline",21,"vit",0]]},{"name":"Shrimp, cooked","sub":"3 oz · 85 g","n":1,"acc":"min","hits":[["Copper",10,"min",0]]},{"name":"Tangerine","sub":"1 large (2-3/4\" dia) · 120 g","n":1,"acc":"vit","hits":[["Choline",12,"vit",0]]},{"name":"Turmeric, ground","sub":"1 tsp · 3 g","n":1,"acc":"min","hits":[["Manganese",8,"min",0]]},{"name":"Veal chop","sub":"3 oz · 85 g","n":1,"acc":"vit","hits":[["Choline",118,"vit",0]]}];
  const IN = new Set(['Natto', 'Oysters, cooked', 'Dates']);   // demo stand-ins for "in your regimen"
  const all = new URLSearchParams(location.search).get('all') === '1';
  const pick = all ? DATA : [
    'Spinach, cooked', 'Lamb liver', 'Natto', 'Beef liver', 'Chickpeas, cooked',
    'Oysters, cooked', 'Walnuts', 'Chicken breast, roasted', 'Dates', 'Sardines, canned with bones',
  ].map(n => DATA.find(d => d.name === n)).filter(Boolean);

  const root = document.getElementById('lb-root');
  const built = [];
  for (const f of pick) {
    const inR = IN.has(f.name);
    const [lk, lp] = f.hits[0];
    const el = document.createElement('div');
    el.className = 'lb-tile';
    el.style.setProperty('--acc', `var(--${f.acc})`);
    el.innerHTML = `
      <div class="lb-bar">
        <div class="lb-bar__txt">
          <div class="lb-name" title="${f.name}">${f.name}</div>
          <div class="lb-meta">${f.sub} · <b>${f.n}</b> of 90</div>
        </div>
        <div class="lb-a">${ctl(inR, f.name)}</div>
      </div>
      <div class="lb-body">
        <div class="lb-lead">
          <div class="lb-lead__pct">${lp}<sup>%</sup></div>
          <div class="lb-lead__of">${lk}</div>
        </div>
        <div class="lb-chips"></div>
      </div>`;
    root.appendChild(el);
    built.push([el.querySelector('.lb-chips'), f.hits.slice(1)]);
  }

  // Fit AFTER the display face loads: measuring in fallback metrics under-measures every chip.
  const run = () => { for (const [h, c] of built) fitChips(h, c); window.__efready = true; };
  if (document.fonts && document.fonts.ready) document.fonts.ready.then(run); else run();

  document.getElementById('lb-note').textContent =
    `F · label · max ${CAP} essentials then “+N” · ≤${MAX_ROWS} chip rows · one 28px control for both states · ${pick.length} shown`;
})();
</script>

<!-- ═══ FRAGMENT GUARD ═══════════════════════════════════════════════════════
     This file is a PARTIAL. It has no <head>, so none of the app's 11 stylesheets are
     loaded and every --ds-* token is undefined: cards lose their background, the fonts fall
     back, and .ui-close (which lives in dashboard.css) renders as a bare grey pill.
     It is meant to be assembled by tools/mockup_harness.py, which supplies the real ancestry.
     Opening it directly shows something that looks broken but is not.
     The banner below appears ONLY when the design system is absent, so it is invisible in the
     harnessed page and impossible to miss outside it. -->
<script>
(() => {
  const ds = getComputedStyle(document.documentElement).getPropertyValue('--ds-ink').trim();
  if (ds) return;                       // harnessed: the design system is present, say nothing
  const b = document.createElement('div');
  b.id = 'frag-guard';
  b.setAttribute('style', 'position:sticky;top:0;z-index:99;margin:0 0 14px;padding:12px 16px;'
    + 'background:#8a2f2f;color:#fff;font:600 13px/1.5 ui-monospace,monospace;border-radius:6px');
  b.innerHTML = 'THIS IS A FRAGMENT, NOT THE DEMO — no app stylesheets are loaded here, so it '
    + 'renders unstyled.<br>Open <b>temporary/food-tile-EF.html</b> instead: the harness supplies the '
    + 'real stylesheets and container geometry.';
  document.body.prepend(b);
})();
</script>

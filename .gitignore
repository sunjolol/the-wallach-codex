# ── Dependencies + build noise ───────────────────────────────────────────────
node_modules/
.npm/
__pycache__/
*.pyc
*.log
*.payload.tmp
dashboard/assets/js/dist/*.map

# ── Per-machine, never shared ────────────────────────────────────────────────
.claude/settings.local.json
.claude/worktrees/

# Rolling per-session development hand-off. Regenerated locally each session.
chronicle/next-chunk.md

# ── Not distributed, by decision ─────────────────────────────────────────────

# The Wallach book texts. These are their authors' copyrighted work and are NOT
# published here. They are kept locally for the corpus derive and for the two
# book-anchored gates; a fresh clone runs without them and those gates skip with
# a clear reason. See eden/corpus/README.md.
eden/corpus/books/*.txt

# Page scans of those same books, used only to verify OCR locally.
temporary/

# Wallach material recorded in full but deliberately held out of the app and out
# of the published repository. Kept on disk for review; nothing in the app or the
# gates reads it.
eden/fringe-knowledge/

# A pinned browser engine, if one is ever installed here. Absent by decision — a
# modern engine is 340-420 MB on disk, so it must never reach git.
engine/

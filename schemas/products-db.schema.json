{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Youngevity Products Database",
  "description": "Canonical catalog of Youngevity products with nutrient amounts, pricing, and label details. Source-rule.md: every product must cite an official Youngevity-primary reference (label image, product page URL, or company statement).",
  "type": "object",
  "required": [
    "products"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "last_updated": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "products": {
      "type": "object",
      "patternProperties": {
        ".*": {
          "type": "object",
          "required": [
            "category"
          ],
          "properties": {
            "category": {
              "type": "string"
            },
            "official_url": {
              "type": [
                "string",
                "null"
              ]
            },
            "label_directions": {
              "type": [
                "string",
                "null"
              ]
            },
            "servings_per_container": {
              "type": [
                "number",
                "integer",
                "string",
                "null"
              ]
            },
            "nutrients": {
              "type": "object",
              "patternProperties": {
                ".*": {
                  "type": "object",
                  "properties": {
                    "amount": {
                      "type": [
                        "number",
                        "integer",
                        "string",
                        "null"
                      ]
                    },
                    "unit": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "form": {
                      "type": "string"
                    },
                    "form_alignment": {
                      "type": "string"
                    }
                  }
                }
              }
            },
            "non_essentials": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "pricing": {
              "type": "object",
              "properties": {
                "retail": {
                  "type": [
                    "number",
                    "string",
                    "null"
                  ]
                },
                "wholesale": {
                  "type": [
                    "number",
                    "string",
                    "null"
                  ]
                }
              }
            },
            "source": {
              "type": "string",
              "description": "REQUIRED by source-rule.md. official_url under youngevity.com OR a label-image reference."
            }
          }
        }
      }
    }
  }
}
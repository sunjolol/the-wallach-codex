{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Versions Manifest",
  "description": "Single source of truth for component versions. The only sanctioned writer is tools/version_bump.py.",
  "type": "object",
  "required": ["current", "history"],
  "properties": {
    "_purpose": {"type": "string"},
    "current": {
      "type": "object",
      "required": ["brain", "dashboard", "updated_iso", "updated_display"],
      "properties": {
        "brain":             {"type": "string", "pattern": "^\\d+\\.\\d+$"},
        "brain_label":       {"type": "string"},
        "dashboard":         {"type": "string", "pattern": "^\\d+\\.\\d+$"},
        "dashboard_label":   {"type": "string"},
        "updated_iso":       {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
        "updated_display":   {"type": "string"}
      }
    },
    "bump_policy":        {"type": "string"},
    "backup_convention":  {"type": "string"},
    "history": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["round", "date", "brain", "dashboard", "summary"],
        "properties": {
          "round":     {"type": "integer", "minimum": 1},
          "date":      {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
          "brain":     {"type": "string"},
          "dashboard": {"type": "string"},
          "summary":   {"type": "string", "minLength": 5}
        }
      }
    }
  }
}
